# Copie este arquivo para ".env" antes de rodar o projeto.

# Gere uma chave forte com: openssl rand -hex 32
SECRET_KEY=troque-por-uma-chave-gerada-com-openssl

# String de conexão do banco. Deixe como está para usar SQLite local,
# ou troque quando a equipe definir o banco final (ver database.py).
DATABASE_URL=sqlite:///./tde.db
